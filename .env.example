# Flask Configuration
FLASK_APP=app
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Database
DATABASE_URL=sqlite:///instance/home_manuals.db

# File Storage
STORAGE_DIR=storage
MAX_FILE_SIZE_MB=50

# Security
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Production only (set to True in prod)
ENABLE_HSTS=False
