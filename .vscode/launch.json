{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flask: Development Server",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "app",
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run",
                "--host=0.0.0.0",
                "--port=5000",
                "--reload"
            ],
            "jinja": true,
            "autoStartBrowser": false,
            "console": "integratedTerminal"
        }
    ]
}
